# --- Media never goes to GitHub ---
# The drop folder, the sorted library and the dupes (defaults)
mogul_incoming/
mogul_library/
mogul_dupes/
mogul_quarantine/

# Safety net: block audio/video files anywhere in the repo,
# even if they end up outside mogul_incoming by mistake
*.mp3
*.ogg
*.oga
*.opus
*.m4a
*.m4b
*.aac
*.flac
*.wma
*.wav
*.mka
*.mkv
*.mp4
*.avi

# Scan reports are logs, kept on your machine only
mogul_reports/

# The catalog (mogul_json/) IS pushed to GitHub on purpose.

# --- This machine's settings (NAS paths etc.) and secrets ---
mogul.local.toml
secrets.toml
.env

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
