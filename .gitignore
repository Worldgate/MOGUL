# --- Media never goes to GitHub ---
# The drop folder for new files
mogul_incoming/

# Safety net: block audio/video files anywhere in the repo,
# even if they end up outside mogul_incoming by mistake
*.mp3
*.ogg
*.oga
*.opus
*.m4a
*.m4b
*.aac
*.flac
*.wma
*.wav
*.mka
*.mkv
*.mp4
*.avi

# Scan reports are logs, kept on your machine only
mogul_reports/

# The catalog (mogul_json/) IS pushed to GitHub on purpose.

# --- Secrets: API keys etc. go in here, never in mogul.toml ---
secrets.toml
.env

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
