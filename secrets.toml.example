# secrets.toml: API keys and passwords. NEVER goes to GitHub.
#
# Copy this file to secrets.toml (next to mogul.toml) and fill it in:
#     cp secrets.toml.example secrets.toml
#     chmod 600 secrets.toml
#
# secrets.toml is in .gitignore.

[tmdb]
# From https://www.themoviedb.org/settings/api  ("API Key").
api_key = ""
# Or the longer "API Read Access Token" instead of the key:
# read_token = ""
